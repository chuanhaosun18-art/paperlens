{
  "manifest_version": 3,
  "name": "PaperLens",
  "version": "0.1.0",
  "description": "AI reading assistant for academic papers: select text, understand it, and build a personal reading log.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "PaperLens",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-paperlens": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Open PaperLens"
    }
  }
}